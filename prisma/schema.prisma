generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // 1. Enable extensions
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}


// -----------------------------------------------------------------------------
// 0. LANGUAGE (For Future Localization Support)
// -----------------------------------------------------------------------------
model Language {
  id                          Int                          @id @default(autoincrement())
  code                        String                       @unique
  name                        String
  isDefault                   Boolean                      @default(false)
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  blogCategoryTranslations    BlogCategoryTranslation[]
  blogPostTranslations        BlogPostTranslation[]

  @@map("languages")
}

// -----------------------------------------------------------------------------
// 1. USERS (The Account & Library)
// -----------------------------------------------------------------------------
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role    @default(USER)

  // Email verification
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?
  // Password reset
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  // Relations
  recognitions  Recognition[]
  favorites     FavoriteReciter[]
  refreshTokens RefreshToken[]
  blogPosts     BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// -----------------------------------------------------------------------------
// 2. REFRESH TOKENS (Auth Session Management)
// -----------------------------------------------------------------------------
model RefreshToken {
  id String @id @default(uuid())

  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime? // null = still valid

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// 3. RECITERS (Main Table - Universal Data)
// -----------------------------------------------------------------------------
model Reciter {
  id               String  @id @default(uuid())
  slug             String  @unique // Universal URL identifier (e.g., mishary-alafasy)
  imageUrl         String?
  countryCode      String? // 2-letter ISO code for flags (e.g., "KW", "EG")
  style            String? // e.g., "Murattal", "Mujawwad"
  
  // External links
  spotifyUrl       String?
  youtubeUrl       String?

  // Cached counter for trending/top charts
  totalDiscoveries Int @default(0)

  // Relations
  translations     ReciterTranslation[]
  recognitions     Recognition[]
  favoritedBy      FavoriteReciter[]
  embeddings       ReciterEmbedding[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([totalDiscoveries])
  @@map("reciters")
}

// -----------------------------------------------------------------------------
// 3.0 RECITER EMBEDDINGS (The AI Brain — one voice print PER RECORDING)
// A reciter enrolled with N recordings gets N rows; matching takes the best
// similarity across all of them, so adding recordings widens recognition
// coverage (different Surahs, mics, recording sessions).
// -----------------------------------------------------------------------------
model ReciterEmbedding {
  id         String   @id @default(uuid())

  reciterId  String
  reciter    Reciter  @relation(fields: [reciterId], references: [id], onDelete: Cascade)

  sourceFile String   // enrollment filename, e.g. "1.mp3" — for traceability
  embedding  Unsupported("vector(192)")

  createdAt  DateTime @default(now())

  @@index([reciterId])
  @@map("reciter_embeddings")
}

// -----------------------------------------------------------------------------
// 3.1 RECITER TRANSLATIONS (Localized Data)
// -----------------------------------------------------------------------------
model ReciterTranslation {
  id          String  @id @default(uuid())
  
  reciterId   String
  reciter     Reciter @relation(fields: [reciterId], references: [id], onDelete: Cascade)
  
  language    String  // "en", "fr", "es", "ar"
  
  name        String  // e.g., "Mishary Alafasy" (en), "مشاري العفاسي" (ar)
  nationality String? // e.g., "Kuwaiti" (en), "Koweïtien" (fr), "كويتي" (ar)
  shortBio    String? @db.Text
  biography   String? @db.Text
  seoTitle    String?
  tags        String? // Comma-separated localized search keywords

  @@unique([reciterId, language]) // A reciter can only have ONE translation per language
  @@index([language])
  @@map("reciter_translations")
}

// -----------------------------------------------------------------------------
// 4. SURAHS (Quran Chapter Reference)
// -----------------------------------------------------------------------------
model Surah {
  id          Int    @id // 1–114, the official Quran number
  arabicName  String // e.g., "الفاتحة"
  englishName String // e.g., "Al-Fatihah"
  ayahCount   Int // total verses in this surah

  recognitions Recognition[]

  @@map("surahs")
}

// -----------------------------------------------------------------------------
// 5. RECOGNITIONS (The "Discoveries" / History)
// -----------------------------------------------------------------------------
model Recognition {
  id String @id @default(uuid())

  // Who searched? (null = anonymous guest)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Who was found?
  reciterId String
  reciter   Reciter @relation(fields: [reciterId], references: [id], onDelete: Cascade)

  // AI result
  confidenceScore Float // 0.0 – 1.0 (e.g., 0.97 = 97%)
  audioDuration   Float? // snippet length in seconds
  audioFileKey    String? // storage key for the uploaded snippet (e.g., S3 key)

  // Surah/Ayah detected (optional — populated when AI can identify it)
  surahId    Int?
  surah      Surah? @relation(fields: [surahId], references: [id], onDelete: SetNull)
  ayahNumber Int?

  // Client metadata
  deviceOs String? // "iOS" | "Android" | "Web"

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reciterId])
  @@index([createdAt])
  @@map("recognitions")
}

// -----------------------------------------------------------------------------
// 6. FAVORITES (The "Saved Artists")
// -----------------------------------------------------------------------------
model FavoriteReciter {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reciterId String
  reciter   Reciter @relation(fields: [reciterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, reciterId]) // composite PK — no redundant UUID needed
  @@index([userId])
  @@map("favorite_reciters")
}


// =============================================
// 7. CONTENT (Blog & SEO)
// =============================================

model BlogCategory {
  id           Int                       @id @default(autoincrement())
  handle       String                    @unique // Universal slug e.g., "technology"
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  
  translations BlogCategoryTranslation[]
  posts        BlogPost[]

  @@map("blog_categories")
}

model BlogCategoryTranslation {
  id              String       @id @default(uuid())
  blogCategoryId  Int
  languageCode    String
  
  title           String       // e.g., "Technology" or "Technologie"
  description     String?      @db.Text
  metaTitle       String?
  metaDescription String?      @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  blogCategory    BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)
  language        Language     @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([blogCategoryId, languageCode])
  @@index([blogCategoryId])
  @@index([languageCode])
  @@map("blog_category_translations")
}

model BlogPost {
  id              Int                   @id @default(autoincrement())
  handle          String                @unique // Universal slug e.g., "how-samaa-identifies-reciters"
  imageUrl        String?
  isPublished     Boolean               @default(false)
  publishedAt     DateTime?
  readTimeMinutes Int?                  // Powers the "7 min read" UI element
  viewCount       Int                   @default(0) //For "Trending Posts"
  
  authorId        String               
  categoryId      Int
  
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  author          User                  @relation(fields: [authorId], references: [id])
  category        BlogCategory          @relation(fields: [categoryId], references: [id])
  translations    BlogPostTranslation[]

  @@index([categoryId])
  @@index([authorId])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id              String   @id @default(uuid())
  blogPostId      Int
  languageCode    String
  
  title           String
  content         String   @db.Text // Ensures capacity for massive articles
  excerpt         String?  @db.Text // Powers the sub-headline under the title in UI
  metaTitle       String?
  metaDescription String?  @db.Text
  tags            String?  // Localized SEO keywords
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blogPost        BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  language        Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([blogPostId, languageCode])
  @@index([blogPostId])
  @@index([languageCode])
  @@map("blog_post_translations")
}