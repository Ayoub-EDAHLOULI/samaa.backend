<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Contact Message — Samaa</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #f0f4f8;
      font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background: #f0f4f8; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <table
            width="620"
            cellpadding="0"
            cellspacing="0"
            style="
              background: #ffffff;
              border-radius: 14px;
              overflow: hidden;
              box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0d3b2e 0%, #1a5c47 100%);
                  padding: 36px 40px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0 0 10px;
                    font-size: 13px;
                    letter-spacing: 4px;
                    text-transform: uppercase;
                    color: rgba(255, 255, 255, 0.55);
                    font-weight: 500;
                  "
                >
                  Samaa · سماع
                </p>
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 22px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                  "
                >
                  New Contact Message
                </h1>
                <p
                  style="
                    margin: 8px 0 0;
                    color: rgba(255, 255, 255, 0.65);
                    font-size: 13px;
                  "
                >
                  Received via the contact form on samaa.app
                </p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 40px">
                <p
                  style="
                    margin: 0 0 28px;
                    color: #374151;
                    font-size: 15px;
                    line-height: 1.6;
                  "
                >
                  Someone reached out through the Samaa website. Here are their
                  details:
                </p>

                <!-- Info Table -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border: 1px solid #e5e7eb;
                    border-radius: 10px;
                    overflow: hidden;
                    margin-bottom: 28px;
                  "
                >
                  <!-- Name -->
                  <tr style="background: #f8fafc">
                    <td
                      style="
                        padding: 14px 20px;
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7280;
                        text-transform: uppercase;
                        letter-spacing: 0.06em;
                        width: 110px;
                        white-space: nowrap;
                      "
                    >
                      Name
                    </td>
                    <td
                      style="
                        padding: 14px 20px;
                        font-size: 14px;
                        color: #111827;
                        font-weight: 600;
                      "
                    >
                      <%= name %>
                    </td>
                  </tr>

                  <!-- Email -->
                  <tr>
                    <td
                      style="
                        padding: 14px 20px;
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7280;
                        text-transform: uppercase;
                        letter-spacing: 0.06em;
                        border-top: 1px solid #e5e7eb;
                        white-space: nowrap;
                      "
                    >
                      Email
                    </td>
                    <td
                      style="
                        padding: 14px 20px;
                        font-size: 14px;
                        color: #111827;
                        border-top: 1px solid #e5e7eb;
                      "
                    >
                      <a
                        href="mailto:<%= email %>"
                        style="
                          color: #1a5c47;
                          text-decoration: none;
                          font-weight: 600;
                        "
                        ><%= email %></a
                      >
                    </td>
                  </tr>

                  <!-- Subject -->
                  <tr style="background: #f8fafc">
                    <td
                      style="
                        padding: 14px 20px;
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7280;
                        text-transform: uppercase;
                        letter-spacing: 0.06em;
                        border-top: 1px solid #e5e7eb;
                        white-space: nowrap;
                      "
                    >
                      Subject
                    </td>
                    <td
                      style="padding: 14px 20px; border-top: 1px solid #e5e7eb"
                    >
                      <span
                        style="
                          display: inline-block;
                          background: #d1fae5;
                          color: #065f46;
                          font-size: 12px;
                          font-weight: 700;
                          padding: 4px 12px;
                          border-radius: 20px;
                          text-transform: capitalize;
                          letter-spacing: 0.04em;
                        "
                        ><%= subject %></span
                      >
                    </td>
                  </tr>
                </table>

                <!-- Message -->
                <p
                  style="
                    margin: 0 0 10px;
                    font-size: 12px;
                    font-weight: 700;
                    color: #6b7280;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                  "
                >
                  Message
                </p>
                <div
                  style="
                    background: #f8fafc;
                    border: 1px solid #e5e7eb;
                    border-radius: 10px;
                    padding: 20px 24px;
                  "
                >
                  <p
                    style="
                      margin: 0;
                      font-size: 15px;
                      color: #374151;
                      line-height: 1.8;
                      white-space: pre-wrap;
                    "
                  >
                    <%= message %>
                  </p>
                </div>

                <!-- Reply CTA -->
                <div style="margin-top: 32px; text-align: center">
                  <a
                    href="mailto:<%= email %>?subject=Re: <%= subject %>"
                    style="
                      display: inline-block;
                      background: #1a5c47;
                      color: #ffffff;
                      font-size: 14px;
                      font-weight: 700;
                      padding: 14px 36px;
                      border-radius: 8px;
                      text-decoration: none;
                      letter-spacing: 0.4px;
                    "
                  >
                    Reply to <%= name %>
                  </a>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background: #f8fafc;
                  padding: 22px 40px;
                  text-align: center;
                  border-top: 1px solid #e5e7eb;
                "
              >
                <p style="margin: 0; font-size: 12px; color: #9ca3af">
                  This message was submitted via the Samaa contact form &mdash;
                  <strong style="color: #6b7280">samaa.app</strong>
                  &mdash; <%= YEAR %>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
